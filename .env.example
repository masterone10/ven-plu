# ===================================================
# VEN+ Standalone Environment Configuration
# ===================================================

# --- A. Public / Client-Safe (Vite & Public Supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sbp_...
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sbp_...

# Public Site Origin (used for OAuth redirects, email links, asset package links)
ORIGIN=http://localhost:3000
VITE_SITE_URL=http://localhost:3000

# --- B. Server-Only Secrets ---
# Supabase Service Role Key (Bypasses RLS for secure server functions & admin tasks)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
